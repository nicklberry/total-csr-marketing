---
const solutionLinks = [
  { label: 'Solution Overview', href: '/solutions/', description: 'See how the full Total CSR system fits together.' },
  { label: 'Hire', href: '/solutions/hiring-insurance-agents/', description: 'Assess applicants and manage agency hiring with more confidence.' },
  { label: 'Assess', href: '/solutions/insurance-skills-assessment/', description: 'Find skill gaps across your existing team before they become client issues.' },
  { label: 'Train', href: '/solutions/insurance-agent-training/', description: 'Structured P&C training for CSRs, producers, and agency staff.' },
  { label: 'Retain', href: '/solutions/retain/', description: 'Daily microlearning that keeps coverage knowledge sharp.' },
  { label: 'LicenseTraQ', href: '/solutions/insurance-compliance-software/', description: 'Track licenses, renewals, and reminders across states.' },
  { label: 'CE', href: '/solutions/ce-approved-states/', description: 'Continuing education built for practical insurance knowledge.' },
  { label: 'Ask Ellie', href: '/solutions/ai-for-insurance-agents/', description: 'Insurance-specific AI support for coverage questions and explanations.' },
];

const resourceLinks = [
  { label: 'Blogs', href: '/insurance-agency-blog/', description: 'Practical articles for agency owners and operations leaders.' },
  { label: 'Glossaries', href: '/insurance-glossary/', description: 'Plain-language definitions for insurance agency teams.' },
  { label: 'eBooks', href: '/ebooks/', description: 'Guides and downloadable resources for agency growth.' },
];

const dropdownNav = [
  { label: 'Solutions', href: '/solutions/', links: solutionLinks, wide: true },
  { label: 'Resources', href: '/insurance-agency-blog/', links: resourceLinks, wide: false },
];
---

<nav class="navbar" id="main-nav">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="Total CSR Home">
      Total CSR
    </a>

    <ul class="navbar-links" id="navbar-links">
      {dropdownNav.map(section => (
        <li class="navbar-dropdown">
          <a href={section.href} class="navbar-link navbar-dropdown-trigger" aria-haspopup="true">
            {section.label}
            <svg class="navbar-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </a>
          <div class:list={["navbar-dropdown-panel", section.wide && "navbar-dropdown-panel--wide"]}>
            <div class="navbar-dropdown-grid">
              {section.links.map(link => (
                <a href={link.href} class="navbar-dropdown-link">
                  <span class="navbar-dropdown-label">{link.label}</span>
                  <span class="navbar-dropdown-description">{link.description}</span>
                </a>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="navbar-right">
      <a href="/demo/" class="btn btn-primary navbar-cta">Book a Demo</a>

      <button class="navbar-hamburger" id="navbar-hamburger" aria-label="Open menu" aria-expanded="false">
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="navbar-mobile-menu" id="navbar-mobile-menu" aria-hidden="true">
    <div class="navbar-mobile-links">
      {dropdownNav.map(section => (
        <div class="navbar-mobile-section">
          <a href={section.href} class="navbar-mobile-heading">{section.label}</a>
          <ul class="navbar-mobile-subnav">
            {section.links.map(link => (
              <li>
                <a href={link.href} class="navbar-mobile-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <a href="/demo/" class="btn btn-primary navbar-mobile-cta">Book a Demo</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-white);
    height: var(--nav-height);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .navbar.scrolled {
    border-bottom: 1px solid var(--color-gray-border);
    box-shadow: var(--shadow-md);
  }

  .navbar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 32px;
    height: var(--nav-height);
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .navbar-logo {
    font-family: 'Nexa Bold', 'Inter', sans-serif;
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-navy);
    text-decoration: none;
    flex-shrink: 0;
    letter-spacing: -0.01em;
  }

  .navbar-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    justify-content: center;
  }

  .navbar-dropdown {
    position: relative;
  }

  .navbar-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-dark);
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .navbar-link:hover,
  .navbar-dropdown:focus-within .navbar-link,
  .navbar-dropdown:hover .navbar-link {
    color: var(--color-navy);
    background-color: var(--color-navy-10);
  }

  .navbar-chevron {
    transition: transform 0.15s ease;
  }

  .navbar-dropdown:hover .navbar-chevron,
  .navbar-dropdown:focus-within .navbar-chevron {
    transform: rotate(180deg);
  }

  .navbar-dropdown-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    width: min(360px, calc(100vw - 48px));
    padding: 14px;
    background: var(--color-white);
    border: 1px solid var(--color-gray-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, 8px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
  }

  .navbar-dropdown-panel::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
  }

  .navbar-dropdown-panel--wide {
    width: min(720px, calc(100vw - 48px));
  }

  .navbar-dropdown:hover .navbar-dropdown-panel,
  .navbar-dropdown:focus-within .navbar-dropdown-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .navbar-dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }

  .navbar-dropdown-panel:not(.navbar-dropdown-panel--wide) .navbar-dropdown-grid {
    grid-template-columns: 1fr;
  }

  .navbar-dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .navbar-dropdown-link:hover,
  .navbar-dropdown-link:focus-visible {
    background: var(--color-navy-10);
    outline: none;
  }

  .navbar-dropdown-label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .navbar-dropdown-description {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-gray-dark);
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .navbar-cta {
    padding: 9px 20px;
    font-size: 0.875rem;
  }

  .navbar-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-navy);
    padding: 4px;
  }

  .navbar-mobile-menu {
    display: none;
    background: var(--color-white);
    border-top: 1px solid var(--color-gray-border);
    padding: 16px 24px 24px;
    max-height: calc(100vh - var(--nav-height));
    overflow-y: auto;
  }

  .navbar-mobile-menu.open {
    display: block;
  }

  .navbar-mobile-links {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .navbar-mobile-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .navbar-mobile-heading {
    display: block;
    padding: 4px 12px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-navy);
  }

  .navbar-mobile-subnav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .navbar-mobile-link {
    display: block;
    padding: 10px 12px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-gray-dark);
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .navbar-mobile-link:hover {
    background-color: var(--color-navy-10);
    color: var(--color-navy);
  }

  .navbar-mobile-cta {
    display: block;
    text-align: center;
    margin-top: 4px;
    width: 100%;
  }

  @media (max-width: 900px) {
    .navbar-links {
      display: none;
    }

    .navbar-hamburger {
      display: block;
    }

    .navbar {
      height: auto;
      min-height: var(--nav-height);
    }

    .navbar-inner {
      height: var(--nav-height);
    }
  }

  @media (max-width: 768px) {
    .navbar-inner {
      padding: 0 24px;
    }
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const hamburger = document.getElementById('navbar-hamburger');
  const mobileMenu = document.getElementById('navbar-mobile-menu');
  const iconMenu = hamburger?.querySelector('.icon-menu') as HTMLElement | null;
  const iconClose = hamburger?.querySelector('.icon-close') as HTMLElement | null;

  // Scroll behavior
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile menu toggle
  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    if (isOpen) {
      mobileMenu?.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
      if (iconMenu) iconMenu.style.display = '';
      if (iconClose) iconClose.style.display = 'none';
    } else {
      mobileMenu?.classList.add('open');
      hamburger.setAttribute('aria-expanded', 'true');
      mobileMenu?.setAttribute('aria-hidden', 'false');
      if (iconMenu) iconMenu.style.display = 'none';
      if (iconClose) iconClose.style.display = '';
    }
  });
</script>
