---
export interface Props {
  name: string;
  description: string;
  icon?: string;
  accentColor?: 'green' | 'navy';
  href: string;
}

const { name, description, icon = 'default', accentColor = 'green', href } = Astro.props;

const icons: Record<string, string> = {
  'user-plus': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>`,
  'clipboard-check': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/><path d="m9 12 2 2 4-4"/></svg>`,
  'book-open': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  'refresh-cw': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v6h6"/><path d="M21 12A9 9 0 0 0 6 5.3L3 8"/><path d="M21 22v-6h-6"/><path d="M3 12a9 9 0 0 0 15 6.7l3-2.7"/></svg>`,
  'shield-check': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  'graduation-cap': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  'message-circle': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  'default': `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>`,
};

const iconSvg = icons[icon] || icons['default'];
---

<a href={href} class={`module-card module-card-${accentColor}`}>
  <div class={`module-card-icon module-card-icon-${accentColor}`} set:html={iconSvg} />
  <h4 class="module-card-name">{name}</h4>
  <p class="module-card-desc">{description}</p>
  <span class="module-card-cta">Learn more &rarr;</span>
</a>

<style>
  .module-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-gray-border);
    padding: 28px 24px;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .module-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .module-card-green::before {
    background-color: var(--color-green);
  }

  .module-card-navy::before {
    background-color: var(--color-navy);
  }

  .module-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .module-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .module-card-icon-green {
    background-color: var(--color-green-10);
    color: var(--color-green-90);
  }

  .module-card-icon-navy {
    background-color: var(--color-navy-10);
    color: var(--color-navy);
  }

  .module-card-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .module-card-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 10px;
  }

  .module-card-desc {
    font-size: 0.9375rem;
    color: var(--color-gray-dark);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 16px;
  }

  .module-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-green);
    transition: color 0.15s ease;
  }

  .module-card-navy .module-card-cta {
    color: var(--color-navy-60);
  }

  .module-card:hover .module-card-cta {
    color: var(--color-green-90);
  }

  .module-card-navy:hover .module-card-cta {
    color: var(--color-navy);
  }
</style>
