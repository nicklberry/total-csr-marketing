---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import CTABand from '../../components/CTABand.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const authorNames: Record<string, string> = {
  'justin@totalcsr.com': 'Justin Goodman',
  'nick@totalcsr.com':   'Nick Berry',
  'MarketingVA':         'Total CSR',
};
const authorDisplay = post.data.author
  ? (authorNames[post.data.author] ?? post.data.author)
  : 'Total CSR';
---

<BaseLayout
  title={`${post.data.title} | Total CSR Blog`}
  description={post.data.excerpt || `${post.data.title} — Total CSR blog for independent P&C agencies.`}
>
  <NavBar />

  <div class="post-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/blog/">Blog</a>
        <span aria-hidden="true">›</span>
        {post.data.categories?.[0] && <span>{post.data.categories[0]}</span>}
      </nav>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span>{authorDisplay}</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{formattedDate}</span>
        {post.data.categories?.length && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            {post.data.categories.map(cat => (
              <span class="post-category">{cat}</span>
            ))}
          </>
        )}
      </div>
      {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
    </div>
  </div>

  <section class="section bg-white">
    <div class="container">
      <div class="post-layout">
        <article class="post-content prose">
          <Content />
        </article>

        <aside class="post-sidebar">
          <div class="sidebar-card">
            <h3>Build real systems for your agency</h3>
            <p>Total CSR gives agency owners and ops managers a structured way to hire, train, and develop insurance staff.</p>
            <a href="/demo/" class="btn-primary">Book a Demo</a>
          </div>
          <div class="sidebar-card sidebar-card--light">
            <h3>More from the blog</h3>
            <a href="/blog/" class="sidebar-link">← All posts</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTABand
    headline="Stop running your agency on assumptions about your people."
    subtext="See how Total CSR works in a 30-minute walkthrough. No pressure. Just the platform."
    ctaLabel="Book a Demo"
    ctaHref="/demo/"
  />

  <Footer />
</BaseLayout>

<style>
  .post-hero {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 48px 0 40px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.65);
    margin-bottom: 16px;
  }

  .breadcrumb a {
    color: rgba(255,255,255,0.65);
    text-decoration: none;
  }

  .breadcrumb a:hover { color: var(--color-white); }

  .post-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-family: 'Nexa Bold', 'Inter', sans-serif;
    color: var(--color-white);
    line-height: 1.2;
    margin: 0 0 16px;
    max-width: 800px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.65);
    margin-bottom: 16px;
  }

  .meta-sep { opacity: 0.4; }

  .post-category {
    background: rgba(255,255,255,0.12);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .post-excerpt {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.8);
    max-width: 680px;
    margin: 0;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
    align-items: start;
  }

  /* Prose */
  .prose :global(h2) {
    font-size: 1.5rem;
    font-family: 'Nexa Bold', 'Inter', sans-serif;
    color: var(--color-navy);
    margin: 2.5rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.1875rem;
    font-family: 'Nexa Bold', 'Inter', sans-serif;
    color: var(--color-navy);
    margin: 2rem 0 0.5rem;
  }

  .prose :global(p) {
    font-size: 1.0625rem;
    color: var(--color-gray-dark);
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin: 0 0 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(li) {
    font-size: 1.0625rem;
    color: var(--color-gray-dark);
    line-height: 1.65;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
  }

  .prose :global(td),
  .prose :global(th) {
    border: 1px solid var(--color-gray-border);
    padding: 10px 14px;
    color: var(--color-gray-dark);
    vertical-align: top;
  }

  .prose :global(tr:first-child td) {
    background: var(--color-gray);
    font-weight: 600;
    color: var(--color-navy);
  }

  .prose :global(strong),
  .prose :global(b) {
    font-weight: 700;
    color: var(--color-navy);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-green-90);
    padding-left: 20px;
    margin: 1.5rem 0;
    color: var(--color-gray-dark);
    font-style: italic;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  /* Sidebar */
  .post-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 24px;
  }

  .sidebar-card {
    background: var(--color-navy);
    color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-card--light {
    background: var(--color-gray);
    color: var(--color-navy);
  }

  .sidebar-card h3 {
    font-size: 1.0625rem;
    font-family: 'Nexa Bold', 'Inter', sans-serif;
    margin: 0;
  }

  .sidebar-card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-green-90);
    color: var(--color-white);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 12px 20px;
    border-radius: 6px;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.15s;
  }

  .btn-primary:hover { opacity: 0.88; }

  .sidebar-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
  }

  .sidebar-link:hover { color: var(--color-green-90); }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
    .post-sidebar { position: static; }
  }
</style>
