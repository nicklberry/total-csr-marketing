---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import ModuleCard from '../components/ModuleCard.astro';

const modules = [
  { name: 'Train', description: 'Structured commercial and personal lines training with full manager visibility and CE credit built in.', icon: 'book-open', accentColor: 'green' as const, href: '/train/' },
  { name: 'Retain', description: 'Five to eight minutes a day. Keeps coverage knowledge sharp and catches false confidence before it causes a mistake.', icon: 'refresh-cw', accentColor: 'navy' as const, href: '/retain/' },
  { name: 'Ask Ellie', description: 'Immediate, insurance-specific answers in plain language. Right when your team needs them.', icon: 'message-circle', accentColor: 'green' as const, href: '/ask-ellie/' },
];
---

<BaseLayout
  title="Thank You | Total CSR"
  description="Thanks for reaching out. Someone from the Total CSR team will be in touch shortly."
>
  <NavBar />

  <section class="thankyou-section">
    <div class="thankyou-inner">
      <div class="check-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1>We will be in touch shortly.</h1>
      <p>Someone from the Total CSR team will reach out within one business day to schedule your walkthrough.</p>
    </div>
  </section>

  <section class="section bg-gray">
    <div class="container">
      <h2 class="modules-heading">In the meantime, take a look at how the platform works.</h2>
      <div class="module-grid-3">
        {modules.map(m => <ModuleCard {...m} />)}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .thankyou-section {
    padding: 100px 32px 80px;
    margin-top: var(--nav-height);
    background: var(--color-white);
    text-align: center;
  }

  .thankyou-inner {
    max-width: 540px;
    margin: 0 auto;
  }

  .check-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-green-10);
    color: var(--color-green-90);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
  }

  .thankyou-inner h1 {
    margin-bottom: 16px;
    font-size: 2.25rem;
  }

  .thankyou-inner p {
    font-size: 1.0625rem;
    color: var(--color-gray-dark);
    line-height: 1.65;
  }

  .modules-heading {
    text-align: center;
    margin-bottom: 40px;
    font-size: 1.75rem;
  }

  .module-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .module-grid-3 { grid-template-columns: 1fr; }
    .thankyou-section { padding: 60px 24px 60px; }
  }
</style>
